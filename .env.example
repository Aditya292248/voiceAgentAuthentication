# Copy to .env and fill in. .env is gitignored; never commit it.

# AgentPhone API key (Bearer token).
AGENTPHONE_API_KEY=

# The number that receives calls, in E.164 format.
MY_NUMBER=+12025550123

# Comma-separated sub-account IDs and the owner name to show for each.
SUB_ACCOUNTS=sa_alice_id:Alice,sa_bob_id:Bob

# ES256 private key for signing verdict tokens (used from a later PR).
# SIGNING_KEY_PATH=keys/verifier.pem

PORT=3000
